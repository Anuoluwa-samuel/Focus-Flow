# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgres://focusflow:focusflow@localhost:54330/focusflow
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
# Public origin of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Leave empty in development to print emails to the server console instead
RESEND_API_KEY=
EMAIL_FROM="FocusFlow <noreply@example.com>"

# Optional: shown on the public Support page
SUPPORT_EMAIL=
